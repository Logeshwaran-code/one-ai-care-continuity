# DEV defaults so `docker compose up` works with zero setup. NEVER use these values outside local demos.
ENV=dev
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# Production: generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHI_ENCRYPTION_KEY=
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set to tesseract only when the native Tesseract binary is installed.
OCR_PROVIDER=none
RATE_LIMIT_PER_MIN=120
SEED_DEMO=true
